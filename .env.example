# --- Yapay zekâ sağlayıcısı ---
# Uygulama, OpenAI uyumlu /chat/completions ucu veren HERHANGİ bir servisle çalışır.
# Anahtar tanımlı değilse oyun yerel motorla çalışmaya devam eder; sahneleri
# yapay zekâ yazmaz.

# 1) OpenAI
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# 2) Google Gemini (OpenAI uyumlu uç) — alternatif
# AI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_MODEL=gemini-2.0-flash

# 3) OpenRouter — alternatif
# AI_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# AI_MODEL=google/gemini-2.0-flash-exp
# AI_REFERER=https://siteniz.com
# AI_TITLE=StoryGen

# Birincil model düşerse sırayla denenecek yedek modeller (virgülle ayrılır).
# AI_FALLBACK_MODELS=gpt-4o-mini,gpt-4.1-mini

# --- İkinci uç (opsiyonel) ---
# Birincil sağlayıcı tamamen düşerse buraya geçilir. Herhangi bir OpenAI
# uyumlu ağ geçidini gösterebilir.
# AI_GATEWAY_KEY=
# AI_GATEWAY_URL=https://ornek-gecit.com/v1/chat/completions
# AI_GATEWAY_MODEL=
# AI_GATEWAY_MODELS=

# --- Dağıtım ---
# Nitro dağıtım hedefi: cloudflare-module (varsayılan) · node-server · vercel · netlify
# NITRO_PRESET=cloudflare-module
